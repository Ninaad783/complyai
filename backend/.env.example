# App
APP_NAME=ComplyAI
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/complyai
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/complyai

# AI Keys
GOOGLE_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Model Settings
DEFAULT_LLM_PROVIDER=google
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/embedding-001

# CORS
FRONTEND_URL=http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
